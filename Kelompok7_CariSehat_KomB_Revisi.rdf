<?xml version="1.0"?>
<rdf:RDF xmlns="http://carisehat.id/ontology/"
     xml:base="http://carisehat.id/ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:hf="http://carisehat.id/ontology/">
    <owl:Ontology rdf:about="http://carisehat.id/ontology/">
        <rdfs:label>CariSehat Ontology</rdfs:label>
        <rdfs:comment>Ontologi CariSehat - Sistem informasi rumah sakit di Indonesia oleh Kelompok 7 Kom B</rdfs:comment>
    </owl:Ontology>

    <!-- 
    ///////////////////////////////////////////////
    // Object Properties (12)
    ///////////////////////////////////////////////
 -->

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/bagianDariProvinsi">
        <owl:inverseOf rdf:resource="http://carisehat.id/ontology/memilikiKabupatenKota"/>
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/KabupatenKota"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/Provinsi"/>
        <rdfs:comment>Menunjukkan kabupaten/kota merupakan bagian dari provinsi tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/beradaDiKabupatenKota">
        <owl:inverseOf rdf:resource="http://carisehat.id/ontology/memilikiRumahSakit"/>
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/KabupatenKota"/>
        <rdfs:comment>Menunjukkan rumah sakit berada di kabupaten/kota tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/beradaDiProvinsi">
        <owl:inverseOf rdf:resource="http://carisehat.id/ontology/memilikiRumahSakitProvinsi"/>
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/Provinsi"/>
        <rdfs:comment>Menunjukkan rumah sakit berada di provinsi tertentu. Dapat di-infer melalui beradaDiKabupatenKota + bagianDariProvinsi.</rdfs:comment>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://carisehat.id/ontology/beradaDiKabupatenKota"/>
            <rdf:Description rdf:about="http://carisehat.id/ontology/bagianDariProvinsi"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/memilikiRumahSakitProvinsi">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Provinsi"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:comment>Menunjukkan provinsi memiliki rumah sakit tertentu (inverse dari beradaDiProvinsi)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/dimilikiOleh">
        <owl:inverseOf rdf:resource="http://carisehat.id/ontology/memilikiFasilitas"/>
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Fasilitas"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:comment>Menunjukkan fasilitas dimiliki oleh rumah sakit tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/disediakanOleh">
        <owl:inverseOf rdf:resource="http://carisehat.id/ontology/menyediakanLayanan"/>
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Layanan"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:comment>Menunjukkan layanan disediakan oleh rumah sakit tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/memilikiFasilitas">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/Fasilitas"/>
        <rdfs:comment>Menunjukkan rumah sakit memiliki fasilitas tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/memilikiKabupatenKota">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Provinsi"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/KabupatenKota"/>
        <rdfs:comment>Menunjukkan provinsi memiliki kabupaten/kota tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/memilikiRumahSakit">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/KabupatenKota"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:comment>Menunjukkan kabupaten/kota memiliki rumah sakit tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/mendukungLayanan">
        <owl:inverseOf rdf:resource="http://carisehat.id/ontology/didukungOlehFasilitas"/>
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Fasilitas"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/Layanan"/>
        <rdfs:comment>Menunjukkan fasilitas mendukung layanan tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/didukungOlehFasilitas">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Layanan"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/Fasilitas"/>
        <rdfs:comment>Menunjukkan layanan didukung oleh fasilitas tertentu (inverse dari mendukungLayanan)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://carisehat.id/ontology/menyediakanLayanan">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://carisehat.id/ontology/Layanan"/>
        <rdfs:comment>Menunjukkan rumah sakit menyediakan layanan tertentu</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 
    ///////////////////////////////////////////////
    // Data Properties (18)
    ///////////////////////////////////////////////
 -->

    <!-- Data Properties untuk Class RumahSakit (10) -->

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/alamat">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Alamat lengkap rumah sakit</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/jenis">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Jenis rumah sakit (Umum atau Khusus)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/kelas">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Kelas rumah sakit (A, B, C, atau D)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/latitude">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Koordinat lintang (latitude) lokasi rumah sakit</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/longitude">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Koordinat bujur (longitude) lokasi rumah sakit</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/menerimaBPJS">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Menunjukkan apakah rumah sakit menerima pasien BPJS</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/nama">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nama resmi rumah sakit</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/pemilik">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Pemilik atau pengelola rumah sakit</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/spesialisasi">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Bidang spesialisasi rumah sakit (untuk RS Khusus)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/telepon">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/RumahSakit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nomor telepon rumah sakit</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Data Properties untuk Class KabupatenKota (2) -->

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/namaKabupatenKota">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/KabupatenKota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nama kabupaten atau kota</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/kodeWilayah">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/KabupatenKota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Kode wilayah administratif kabupaten/kota (BPS)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Data Properties untuk Class Provinsi (2) -->

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/namaProvinsi">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Provinsi"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nama provinsi</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/kodeProvinsi">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Provinsi"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Kode wilayah provinsi (BPS)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Data Properties untuk Class Layanan (2) -->

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/namaLayanan">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Layanan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nama layanan kesehatan</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/deskripsiLayanan">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Layanan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Deskripsi singkat tentang layanan kesehatan</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Data Properties untuk Class Fasilitas (2) -->

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/namaFasilitas">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Fasilitas"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nama fasilitas rumah sakit</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://carisehat.id/ontology/statusOperasional">
        <rdfs:domain rdf:resource="http://carisehat.id/ontology/Fasilitas"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Status apakah fasilitas sedang beroperasi atau tidak</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 
    ///////////////////////////////////////////////
    // Classes (5)
    ///////////////////////////////////////////////
 -->

    <owl:Class rdf:about="http://carisehat.id/ontology/RumahSakit">
        <rdfs:comment>Institusi pelayanan kesehatan yang menyediakan pelayanan rawat inap, rawat jalan, dan gawat darurat</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://carisehat.id/ontology/KabupatenKota">
        <rdfs:comment>Wilayah administratif tingkat kabupaten atau kota di Indonesia</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://carisehat.id/ontology/Provinsi">
        <rdfs:comment>Wilayah administratif tingkat provinsi di Indonesia</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://carisehat.id/ontology/Layanan">
        <rdfs:comment>Jenis layanan kesehatan yang disediakan oleh rumah sakit</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://carisehat.id/ontology/Fasilitas">
        <rdfs:comment>Fasilitas fisik atau peralatan yang dimiliki oleh rumah sakit</rdfs:comment>
    </owl:Class>

    <!-- Disjoint Classes: Semua class saling eksklusif -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://carisehat.id/ontology/RumahSakit"/>
            <rdf:Description rdf:about="http://carisehat.id/ontology/KabupatenKota"/>
            <rdf:Description rdf:about="http://carisehat.id/ontology/Provinsi"/>
            <rdf:Description rdf:about="http://carisehat.id/ontology/Layanan"/>
            <rdf:Description rdf:about="http://carisehat.id/ontology/Fasilitas"/>
        </owl:members>
    </owl:AllDisjointClasses>

