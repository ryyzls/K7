rs:rs-001  a                      hf:RumahSakit;
        hf:alamat                 "Jl. Olahraga No. 1";
        hf:beradaDiKabupatenKota  kk:kota-binjai;
        hf:jenis                  "Umum";
        hf:kelas                  "C";
        hf:memilikiFasilitas      fas:ambulans , fas:icu , fas:instalasi-farmasi , fas:instalasi-gawat-darurat , fas:kamar-operasi , fas:laboratorium , fas:ruang-rawat-inap;
        hf:menerimaBPJS           true;
        hf:menyediakanLayanan     lay:bedah , lay:kebidanan-dan-kandungan , lay:kesehatan-anak , lay:laboratorium , lay:penyakit-dalam , lay:radiologi , lay:rawat-inap , lay:ugd-24-jam;
        hf:pemilik                "Perusahaan";
        hf:standarRegulasi        "Permenkes No. 3 Tahun 2020";
        hf:sumberKoordinat        "jalan";
        geo:lat                   3.606607;
        geo:long                  98.497722;
        schema:image              "/images/rs/rs-001/foto_1.jpg" , "/images/rs/rs-001/foto_2.jpg" , "/images/rs/rs-001/foto_3.jpg";
        schema:name               "Og Hospital";
        schema:telephone          "06142365911" .

hf:RumahSakit  a         owl:Class;
        rdfs:comment     "Institusi pelayanan kesehatan yang menyelenggarakan pelayanan kesehatan perorangan secara paripurna.";
        rdfs:label       "Rumah Sakit";
        rdfs:subClassOf  schema:Hospital .

hf:jenis  a          owl:DatatypeProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "jenis rumah sakit (Umum/Khusus)";
        rdfs:range   xsd:string .

hf:kelas  a          owl:DatatypeProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "kelas perizinan rumah sakit (A/B/C/D)";
        rdfs:range   xsd:string .

hf:alamat  a                owl:DatatypeProperty;
        rdfs:domain         hf:RumahSakit;
        rdfs:label          "alamat lokasi fisik";
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  schema:streetAddress .

hf:pemilik  a        owl:DatatypeProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "pemilik atau penyelenggara rumah sakit";
        rdfs:range   xsd:string .

hf:beradaDiKabupatenKota
        a            owl:ObjectProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "berada di kabupaten/kota";
        rdfs:range   hf:KabupatenKota .

hf:menerimaBPJS  a   owl:DatatypeProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "menerima pasien BPJS Kesehatan";
        rdfs:range   xsd:boolean .

hf:standarRegulasi  a  owl:DatatypeProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "dasar regulasi penentuan layanan minimal";
        rdfs:range   xsd:string .

hf:sumberKoordinat  a  owl:DatatypeProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "sumber data koordinat (osm/nama/jalan/kabkota)";
        rdfs:range   xsd:string .

hf:menyediakanLayanan
        a                   owl:ObjectProperty;
        rdfs:domain         hf:RumahSakit;
        rdfs:label          "menyediakan layanan medis";
        rdfs:range          hf:Layanan;
        rdfs:subPropertyOf  schema:availableService .

hf:memilikiFasilitas  a  owl:ObjectProperty;
        rdfs:domain  hf:RumahSakit;
        rdfs:label   "memiliki fasilitas fisik";
        rdfs:range   hf:Fasilitas .

