# DATA CONTOH v0 (koordinat perkiraan). Diganti dataset buatan P3 setelah Contract Freeze.
@prefix hf: <http://carisehat.id/ontology/> .
@prefix schema: <https://schema.org/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rs: <http://localhost:8000/rs/> .
@prefix kk: <http://localhost:8000/kabkota/> .
@prefix prov: <http://localhost:8000/provinsi/> .
@prefix lay: <http://localhost:8000/layanan/> .
@prefix fas: <http://localhost:8000/fasilitas/> .

hf:RumahSakit a owl:Class ; rdfs:subClassOf schema:Hospital ; rdfs:label "Rumah Sakit" .
hf:KabupatenKota a owl:Class ; rdfs:label "Kabupaten/Kota" .
hf:Provinsi a owl:Class ; rdfs:label "Provinsi" .
hf:Layanan a owl:Class ; rdfs:label "Layanan" .
hf:Fasilitas a owl:Class ; rdfs:label "Fasilitas" .

prov:sumut a hf:Provinsi ; rdfs:label "Sumatera Utara" .
kk:kota-medan a hf:KabupatenKota ; rdfs:label "Kota Medan" ; hf:bagianDariProvinsi prov:sumut .
kk:kota-pematangsiantar a hf:KabupatenKota ; rdfs:label "Kota Pematangsiantar" ; hf:bagianDariProvinsi prov:sumut .
kk:kab-tapanuli-utara a hf:KabupatenKota ; rdfs:label "Kab. Tapanuli Utara" ; hf:bagianDariProvinsi prov:sumut .
kk:kab-karo a hf:KabupatenKota ; rdfs:label "Kab. Karo" ; hf:bagianDariProvinsi prov:sumut .
kk:kota-gunungsitoli a hf:KabupatenKota ; rdfs:label "Kota Gunungsitoli" ; hf:bagianDariProvinsi prov:sumut .

lay:igd a hf:Layanan ; rdfs:label "IGD" .
lay:jantung a hf:Layanan ; rdfs:label "Jantung" .
lay:anak a hf:Layanan ; rdfs:label "Anak" .
lay:bersalin a hf:Layanan ; rdfs:label "Bersalin" .
lay:bedah a hf:Layanan ; rdfs:label "Bedah" .
lay:saraf a hf:Layanan ; rdfs:label "Saraf" .
lay:radiologi a hf:Layanan ; rdfs:label "Radiologi" .
fas:icu a hf:Fasilitas ; rdfs:label "ICU" .
fas:laboratorium a hf:Fasilitas ; rdfs:label "Laboratorium" .
fas:ambulans a hf:Fasilitas ; rdfs:label "Ambulans" .

rs:rs-001 a hf:RumahSakit ; schema:name "RSUP H. Adam Malik" ; hf:jenis "Umum" ; hf:kelas "A" ;
  hf:alamat "Jl. Bunga Lau, Medan" ; hf:beradaDiKabupatenKota kk:kota-medan ;
  geo:lat "3.512"^^xsd:decimal ; geo:long "98.607"^^xsd:decimal ;
  hf:menyediakanLayanan lay:igd, lay:jantung, lay:anak, lay:bedah, lay:saraf, lay:radiologi ;
  hf:memilikiFasilitas fas:icu, fas:laboratorium, fas:ambulans .
rs:rs-002 a hf:RumahSakit ; schema:name "RSUD Dr. Pirngadi" ; hf:jenis "Umum" ; hf:kelas "B" ;
  hf:alamat "Jl. Prof. H.M. Yamin, Medan" ; hf:beradaDiKabupatenKota kk:kota-medan ;
  geo:lat "3.580"^^xsd:decimal ; geo:long "98.683"^^xsd:decimal ;
  hf:menyediakanLayanan lay:igd, lay:anak, lay:bersalin, lay:bedah ;
  hf:memilikiFasilitas fas:icu, fas:laboratorium .
rs:rs-003 a hf:RumahSakit ; schema:name "RSUD Dr. Djasamen Saragih" ; hf:jenis "Umum" ; hf:kelas "B" ;
  hf:alamat "Pematangsiantar" ; hf:beradaDiKabupatenKota kk:kota-pematangsiantar ;
  geo:lat "2.961"^^xsd:decimal ; geo:long "99.061"^^xsd:decimal ;
  hf:menyediakanLayanan lay:igd, lay:anak, lay:bedah, lay:radiologi ;
  hf:memilikiFasilitas fas:icu, fas:ambulans .
rs:rs-004 a hf:RumahSakit ; schema:name "RSUD Tarutung" ; hf:jenis "Umum" ; hf:kelas "C" ;
  hf:alamat "Tarutung" ; hf:beradaDiKabupatenKota kk:kab-tapanuli-utara ;
  geo:lat "2.023"^^xsd:decimal ; geo:long "98.965"^^xsd:decimal ;
  hf:menyediakanLayanan lay:igd, lay:bersalin, lay:anak ;
  hf:memilikiFasilitas fas:laboratorium .
rs:rs-005 a hf:RumahSakit ; schema:name "RSUD Kabanjahe" ; hf:jenis "Umum" ; hf:kelas "C" ;
  hf:alamat "Kabanjahe" ; hf:beradaDiKabupatenKota kk:kab-karo ;
  geo:lat "3.100"^^xsd:decimal ; geo:long "98.490"^^xsd:decimal ;
  hf:menyediakanLayanan lay:igd, lay:bedah, lay:bersalin ;
  hf:memilikiFasilitas fas:laboratorium, fas:ambulans .
rs:rs-006 a hf:RumahSakit ; schema:name "RSUD Gunungsitoli" ; hf:jenis "Umum" ; hf:kelas "C" ;
  hf:alamat "Gunungsitoli" ; hf:beradaDiKabupatenKota kk:kota-gunungsitoli ;
  geo:lat "1.290"^^xsd:decimal ; geo:long "97.615"^^xsd:decimal ;
  hf:menyediakanLayanan lay:igd, lay:anak ;
  hf:memilikiFasilitas fas:ambulans .
