# Ontologi CariSehat v1 (Kelas, Properti, dan Keselarasan Kosakata Internasional).
# Standar W3C OWL 2 & schema.org medical vocabulary.

@prefix hf: <http://carisehat.id/ontology/> .
@prefix schema: <https://schema.org/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# --- Definisi Ontologi ---
<http://carisehat.id/ontology/> a owl:Ontology ;
  rdfs:label "Ontologi Fasilitas Kesehatan CariSehat Sumatera Utara" ;
  rdfs:comment "Ontologi untuk memodelkan rumah sakit, layanan medis standar Permenkes No. 3/2020, dan integrasi linked open data DBpedia." .

# --- Kelas Utama (Classes) ---
hf:RumahSakit a owl:Class ;
  rdfs:subClassOf schema:Hospital ;
  rdfs:label "Rumah Sakit" ;
  rdfs:comment "Institusi pelayanan kesehatan yang menyelenggarakan pelayanan kesehatan perorangan secara paripurna." .

hf:KabupatenKota a owl:Class ;
  rdfs:subClassOf schema:AdministrativeArea ;
  rdfs:label "Kabupaten/Kota" .

hf:Provinsi a owl:Class ;
  rdfs:subClassOf schema:AdministrativeArea ;
  rdfs:label "Provinsi" .

hf:Layanan a owl:Class ;
  rdfs:subClassOf schema:MedicalProcedure ;
  rdfs:label "Layanan Medis" .

hf:Fasilitas a owl:Class ;
  rdfs:subClassOf schema:LocationFeatureSpecification ;
  rdfs:label "Fasilitas Rumah Sakit" .

# --- Properti Objek (Object Properties) ---
hf:beradaDiKabupatenKota a owl:ObjectProperty ;
  rdfs:label "berada di kabupaten/kota" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range hf:KabupatenKota .

hf:bagianDariProvinsi a owl:ObjectProperty ;
  rdfs:label "bagian dari provinsi" ;
  rdfs:domain hf:KabupatenKota ;
  rdfs:range hf:Provinsi .

hf:menyediakanLayanan a owl:ObjectProperty ;
  rdfs:subPropertyOf schema:availableService ;
  rdfs:label "menyediakan layanan medis" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range hf:Layanan .

hf:memilikiFasilitas a owl:ObjectProperty ;
  rdfs:label "memiliki fasilitas fisik" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range hf:Fasilitas .

# --- Properti Data (Datatype Properties) ---
hf:jenis a owl:DatatypeProperty ;
  rdfs:label "jenis rumah sakit (Umum/Khusus)" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:string .

hf:spesialisasi a owl:DatatypeProperty ;
  rdfs:label "spesialisasi khusus rumah sakit" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:string .

hf:kelas a owl:DatatypeProperty ;
  rdfs:label "kelas perizinan rumah sakit (A/B/C/D)" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:string .

hf:pratama a owl:DatatypeProperty ;
  rdfs:label "status rumah sakit pratama" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:boolean .

hf:pemilik a owl:DatatypeProperty ;
  rdfs:label "pemilik atau penyelenggara rumah sakit" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:string .

hf:alamat a owl:DatatypeProperty ;
  rdfs:subPropertyOf schema:streetAddress ;
  rdfs:label "alamat lokasi fisik" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:string .

hf:sumberKoordinat a owl:DatatypeProperty ;
  rdfs:label "sumber data koordinat (osm/nama/jalan/kabkota)" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:string .

hf:menerimaBPJS a owl:DatatypeProperty ;
  rdfs:label "menerima pasien BPJS Kesehatan" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:boolean .

hf:standarRegulasi a owl:DatatypeProperty ;
  rdfs:label "dasar regulasi penentuan layanan minimal" ;
  rdfs:domain hf:RumahSakit ;
  rdfs:range xsd:string .

# --- Properti Foto (Photo Property) ---
# Menggunakan schema:image (standar schema.org) untuk URL foto RS.
# schema:image sudah terdefinisi oleh schema.org, tidak perlu deklarasi ulang.
# Foto bersumber dari Google Maps Places API, hak cipta pengambil foto asli.

# Official website verification metadata; schema:url is reserved for reviewed URLs.
hf:websiteStatus a owl:DatatypeProperty ; rdfs:domain hf:RumahSakit ; rdfs:range xsd:string .
hf:websiteEvidence a owl:ObjectProperty ; rdfs:domain hf:RumahSakit .
hf:websiteCheckedAt a owl:DatatypeProperty ; rdfs:domain hf:RumahSakit ; rdfs:range xsd:dateTime .
hf:websiteScope a owl:DatatypeProperty ; rdfs:domain hf:RumahSakit ; rdfs:range xsd:string .
hf:websiteNotes a owl:DatatypeProperty ; rdfs:domain hf:RumahSakit ; rdfs:range xsd:string .
hf:websiteCandidate a owl:ObjectProperty ; rdfs:domain hf:RumahSakit .
