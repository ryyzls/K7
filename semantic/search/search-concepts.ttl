  skos:prefLabel "Laboratorium mikrobiologi"@id ;
  skos:broader csc:pemeriksaan-laboratorium .

csc:icu a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "ICU"@id ;
