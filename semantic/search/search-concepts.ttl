  skos:prefLabel "Kesehatan anak"@id ;
  cs:labelPelayanan "Kesehatan anak" ;
  skos:broader csc:layanan-kesehatan-anak ;
  skos:altLabel "dokter anak"@id, "spesialis anak"@id, "pediatri"@id, "pediatrik"@id, "poli anak"@id .

csc:obgyn a skos:Concept ;
