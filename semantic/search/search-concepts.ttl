@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cs: <http://carisehat.id/ontology/sirs/> .
@prefix hf: <http://carisehat.id/ontology/> .
@prefix csc: <http://carisehat.id/search/concept/> .

<http://carisehat.id/search/scheme> a skos:ConceptScheme ;
  rdfs:label "Skema Konsep Pencarian Layanan & Fasilitas CariSehat"@id ;
  skos:hasTopConcept csc:pencitraan-medis, csc:perawatan-intensif, csc:layanan-kesehatan-anak,
                     csc:kesehatan-ibu-kandungan, csc:pemeriksaan-laboratorium, csc:gawat-darurat .

# --- Konsep Payung (Broader Concepts) ---
csc:pencitraan-medis a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "pencitraan medis"@id ;
  skos:altLabel "imaging medis"@id, "diagnostik pencitraan"@id ;
  skos:narrower csc:radiologi, csc:ct-scan, csc:usg .

csc:perawatan-intensif a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "perawatan intensif"@id ;
  skos:altLabel "ruang intensif"@id, "rawat intensif"@id ;
  skos:narrower csc:icu, csc:nicu, csc:picu, csc:hcu, csc:iccu .

csc:layanan-kesehatan-anak a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "layanan kesehatan anak"@id ;
  skos:altLabel "kesehatan anak dan bayi"@id ;
  skos:narrower csc:kesehatan-anak, csc:nicu, csc:picu .

csc:kesehatan-ibu-kandungan a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "kesehatan ibu dan kandungan"@id ;
  skos:altLabel "kebidanan dan kandungan"@id, "layanan ibu dan anak"@id ;
  skos:narrower csc:obgyn .

csc:pemeriksaan-laboratorium a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "pemeriksaan laboratorium"@id ;
  skos:altLabel "cek lab"@id, "uji laboratorium"@id ;
  skos:narrower csc:lab-klinik, csc:patologi-klinik, csc:lab-mikrobiologi .

# --- Konsep Spesialisasi Klinis (16 Spesialisasi Aktif SIRS) ---
csc:jantung a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "Jantung dan Pembuluh Darah"@id ;
  cs:labelPelayanan "Jantung dan Pembuluh Darah" ;
  skos:altLabel "dokter jantung"@id, "spesialis jantung"@id, "jantung"@id, "kardiologi"@id,
                "kardiovaskular"@id, "kardiovaskuler"@id, "poli jantung"@id .

csc:kesehatan-anak a skos:Concept ;
