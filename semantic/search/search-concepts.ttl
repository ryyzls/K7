  skos:altLabel "dokter kandungan"@id, "spesialis kandungan"@id, "obgyn"@id, "dokter obgyn"@id,
                "spog"@id, "kebidanan"@id, "kandungan"@id, "poli kandungan"@id, "obstetri"@id, "ginekologi"@id .

