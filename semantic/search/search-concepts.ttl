# --- Konsep Fasilitas & Diagnostik ---
csc:gawat-darurat a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "Pelayanan Gawat Darurat Umum 24 jam & 7 hari seminggu"@id ;
  cs:labelPelayanan "Pelayanan Gawat Darurat Umum 24 jam & 7 hari seminggu" ;
  skos:altLabel "igd"@id, "ugd"@id, "igd 24 jam"@id, "ugd 24 jam"@id, "gawat darurat"@id, "emergency"@id .

csc:radiologi a skos:Concept ;
  skos:inScheme <http://carisehat.id/search/scheme> ;
  skos:prefLabel "Radiologi"@id ;
  skos:broader csc:pencitraan-medis ;
  skos:altLabel "rontgen"@id, "radiografi"@id, "x-ray"@id, "xray"@id .

